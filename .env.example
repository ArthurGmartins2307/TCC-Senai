# ==============================================================================
# Fato ou Farsa - Configuração de Variáveis de Ambiente e Integração de APIs
# ==============================================================================
# IMPORTANTE: Nunca inclua chaves reais de produção neste arquivo de exemplo.
# Mantenha suas credenciais seguras no arquivo .env local ou nas Secrets da nuvem.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Obrigatório para Análise com Inteligência Artificial)
# ------------------------------------------------------------------------------
# Modelo utilizado: gemini-3.8-flash com suporte a Google Search Grounding.
# O AI Studio injeta automaticamente esta variável em tempo de execução via segredos.
# Para configurar manualmente, obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"

# ------------------------------------------------------------------------------
# 2. META INSTAGRAM GRAPH API (Opcional para Coleta Direta de Contas Vinculadas)
# ------------------------------------------------------------------------------
# A Meta exige que o aplicativo seja registrado no Meta for Developers
# (https://developers.facebook.com) e configurado com o produto "Instagram Graph API".
#
# Permissões mínimas exigidas (App Review ou Desenvolvedores em modo Sandbox):
# - instagram_basic
# - instagram_manage_insights
# - pages_show_list
#
# Para contas de terceiros não autorizadas, a Meta restringe o acesso direto via API pública.
# Nesses casos, o Fato ou Farsa utiliza automaticamente o Sandbox Forense ou a
# ferramenta de Verificação Direta de Conteúdo / Legenda.
INSTAGRAM_ACCESS_TOKEN="SEU_TOKEN_DE_LONGA_DURACAO_META"
INSTAGRAM_APP_ID="SEU_APP_ID_META"
INSTAGRAM_APP_SECRET="SEU_APP_SECRET_META"

# ------------------------------------------------------------------------------
# 3. BUSCA E CHECAGEM DE FATOS (Opcional para APIs adicionais de Search)
# ------------------------------------------------------------------------------
# Por padrão, o Fato ou Farsa utiliza a ferramenta Google Search Grounding integrada
# nativamente ao SDK @google/genai através do GEMINI_API_KEY, combinada com a
# Base Forense Nacional (ANVISA, CFM, SBD, CVM, Agência Lupa e Aos Fatos).
# Caso queira integrar um motor de busca web adicional dedicado:
FACT_CHECK_SEARCH_API_KEY=""

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES DO SERVIDOR
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
