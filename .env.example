# ==============================================================================
# Fato ou Farsa - Configuração de Variáveis de Ambiente e Integração de APIs (TikTok)
# ==============================================================================
# IMPORTANTE: Nunca inclua chaves reais de produção neste arquivo de exemplo.
# Mantenha suas credenciais seguras no arquivo .env local ou nas Secrets da nuvem.

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI API (Obrigatório para Análise com Inteligência Artificial)
# ------------------------------------------------------------------------------
# Modelo utilizado: gemini-3.8-flash com suporte a Google Search Grounding.
# O AI Studio injeta automaticamente esta variável em tempo de execução via segredos.
# Para configurar manualmente, obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="SUA_CHAVE_GEMINI_API_AQUI"

# ------------------------------------------------------------------------------
# 2. TIKTOK DEVELOPER APIS (TikTok Display API & Login Kit)
# ------------------------------------------------------------------------------
# O TikTok exige cadastro em https://developers.tiktok.com/ e criação de aplicativo.
#
# Produto recomendado: TikTok Display API
# Permissões / Scopes homologados:
# - user.info.basic (identificador, avatar, nome de exibição)
# - user.info.profile (biografia, link do perfil)
# - user.info.stats (contagem de seguidores, curtidas acumuladas, vídeos)
# - video.list (lista de vídeos e estatísticas de reproduções e curtidas)
#
# NOTA SOBRE RESTRIÇÕES TIKTOK:
# - A Display API só acessa vídeos da própria conta que autorizou o app via Login Kit.
# - Para contas públicas de terceiros sem autorização, o Fato ou Farsa utiliza
#   automaticamente o fluxo de inserção de transcrições/legendas e o Sandbox Didático.
# - A TikTok Research API é restrita exclusivamente a pesquisadores acadêmicos elegíveis.
TIKTOK_CLIENT_KEY="SEU_CLIENT_KEY_TIKTOK"
TIKTOK_CLIENT_SECRET="SEU_CLIENT_SECRET_TIKTOK"
TIKTOK_ACCESS_TOKEN="SEU_ACCESS_TOKEN_TIKTOK_LOGIN_KIT"

# ------------------------------------------------------------------------------
# 3. BUSCA E CHECAGEM DE FATOS
# ------------------------------------------------------------------------------
# O Fato ou Farsa utiliza a ferramenta Google Search Grounding nativamente no SDK
# @google/genai através do GEMINI_API_KEY, combinada com a Base Forense Nacional
# (ANVISA, CFM, SBD, CVM, Agência Lupa, Aos Fatos e Projeto Comprova).
FACT_CHECK_SEARCH_API_KEY=""

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES DO SERVIDOR
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
